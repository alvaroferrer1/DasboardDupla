{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dos-espacios-compartido",
  "main": "edge/worker.mjs",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./edge/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DOS_ROOM",
        "class_name": "DosRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DosRoom"
      ]
    }
  ],
  "workers_dev": true,
  "vars": {
    "PUBLIC_ORIGIN": "https://dos-espacios-compartido.dos-espacios-ferris.workers.dev"
  },
  "ai": {
    "binding": "AI"
  }
}
