# Copia este archivo como .env. No compartas tus credenciales.
PORT=3077
HOST=127.0.0.1
# En producción, tras poner HTTPS y proxy inverso, cambia COOKIE_SECURE=true.
COOKIE_SECURE=false
# Solo para la zona de TRABAJO. No se usará para Planes en común.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Opcional: URL HTTPS de webhook n8n/Make/otro, configurada por el administrador.
# El webhook recibirá SOLO metadatos de cambios de Trabajo, nunca Planes en común.
WORK_WEBHOOK_URL=
# Solo para el despliegue con Docker + Caddy (DNS apuntando al VPS):
DOMAIN=

# Opcional (recomendado en la nube): secreto aleatorio de al menos 32 caracteres para crear las dos cuentas
# desde la primera pantalla web. Retíralo del alojamiento después de crear las cuentas.
SETUP_TOKEN=

# Dominio HTTPS público exacto para revisar CSRF cuando se usa proxy HTTPS.
PUBLIC_ORIGIN=
